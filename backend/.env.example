POSTGRES_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_USER=unkre
POSTGRES_PASSWORD=replace-with-local-database-password
POSTGRES_DB=unkre
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

JWT_ALGORITHM=HS256
ACCESS_KEY_TIMEDELTA_MINUTES=15
REFRESH_KEY_TIMEDELTA_MINUTES=43200
# Згенеруйте два різні секрети: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY_ACCESS=replace-with-random-access-secret-at-least-32-bytes
SECRET_KEY_REFRESH=replace-with-another-random-refresh-secret-at-least-32-bytes

# Google Cloud Console → OAuth 2.0 Client ID → Web application.
GOOGLE_CLIENT_ID=
# BotFather → ваш бот → Login Widget → Client ID (RS256).
TELEGRAM_CLIENT_ID=
AUTH_CHALLENGE_TTL_SECONDS=300
# Початкові кредити та реферальні бонуси керуються в Admin → Settings.

RUNPOD_API_KEY=
# Legacy single endpoint. Ignored when RUNPOD_ENDPOINTS is set.
RUNPOD_ENDPOINT_ID=
# One endpoint per workflow. Key = exact workflows.name in the DB (also the JSON
# file name under src/adapters/runpod/workflows). Accepts workflow=endpoint pairs
# separated by commas, or JSON. When set, every workflow must have exactly one
# entry and RUNPOD_ENDPOINT_ID is ignored.
# Example: RUNPOD_ENDPOINTS=krea2_turbo_all_api=abc123,krea2_raw_t2image_api=def456
RUNPOD_ENDPOINTS=
RUNPOD_TIMEOUT_SECONDS=30

REDIS_URL=redis://localhost:6379/0
TASK_QUEUE_NAME=unkre:tasks
TASK_QUEUE_MAX_JOBS=10
TASK_QUEUE_MAX_TRIES=5
TASK_QUEUE_JOB_TIMEOUT_SECONDS=90
GENERATION_POLL_INTERVAL_SECONDS=5
# Скільки днів зберігати завершені, скасовані та невдалі генерації.
GENERATION_RETENTION_DAYS=7
# Скільки записів обробляти за один запуск cleanup_generations.
GENERATION_CLEANUP_BATCH_SIZE=50
# Скільки об'єктів MinIO перевіряти за один запуск cleanup_generation_images.
IMAGE_CLEANUP_BATCH_SIZE=100
# Скільки годин файл без запису генерації вважається сиротою.
IMAGE_ORPHAN_GRACE_HOURS=1

# Ціни, мінімальні суми та валюта checkout керуються в Admin → Settings → Payments.
CRYPTO_CURRENCY=USD
ATLOS_MERCHANT_ID=
ATLOS_API_SECRET=
TELEGRAM_BOT_TOKEN=
# URL the /start button opens as a Telegram MiniApp. Telegram requires https;
# http://localhost is accepted for local experiments.
TELEGRAM_MINIAPP_URL=
# Скільки секунд initData вважається свіжим для входу в MiniApp.
TELEGRAM_WEBAPP_AUTH_TTL_SECONDS=3600
TELEGRAM_WEBHOOK_SECRET=
PAYMENT_INVOICE_TTL_SECONDS=3600
PAYMENT_POSTBACK_URL=https://unkre.cc/api/payments/webhooks/atlos
PAYMENT_PROVIDER_TIMEOUT_SECONDS=10

# Через кому, без кінцевого слеша; порожнє значення — запити з того самого origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_ENABLED=true
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# Redis спільний із чергою (REDIS_URL). false — лише для локального одного процесу.
SECURITY_REDIS_ENABLED=true
SECURITY_REDIS_PREFIX=unkre:guard:
SECURITY_RATE_LIMIT=1200
SECURITY_RATE_LIMIT_WINDOW=60
SECURITY_ROUTE_RATE_LIMIT_ENABLED=true
SECURITY_AUTO_BAN_THRESHOLD=10
SECURITY_AUTO_BAN_DURATION=3600
SECURITY_ENFORCE_HTTPS=false
# IP/CIDR фактичного reverse proxy через кому. Порожнє — не довіряти proxy headers.
SECURITY_TRUSTED_PROXIES=
SECURITY_BLOCKED_USER_AGENTS=
SECURITY_PASSIVE_MODE=false

# Owner-акаунт адмін-панелі, створюється на старті API.
# Потрібні обидва значення; пароль — мінімум 10 символів.
# Існуючий акаунт не перезаписується, тому зміна пароля тут не діє.
ADMIN_NAME=
ADMIN_PASSWORD=

# Тимчасовий кеш згенерованих зображень у MinIO.
# Порожній MINIO_ENDPOINT вимикає кеш: API віддає результат напряму з RunPod.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=unkre-images
MINIO_SECURE=false
# Скільки годин зображення живе в MinIO. Далі його видаляє lifecycle-правило
# або фонова задача cleanup_generation_images.
MINIO_RETENTION_HOURS=24
