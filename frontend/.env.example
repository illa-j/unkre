# Absolute public URL, e.g. https://your-domain.com. Leave empty for local preview.
NEXT_PUBLIC_SITE_URL=
# Indexing is enabled by default. Set false only for a private preview deployment.
SITE_INDEXABLE=true
# API URL in the browser. /api uses the Next.js rewrite to BACKEND_URL.
NEXT_PUBLIC_API_URL=/api
# Server-only address of the existing FastAPI application.
BACKEND_URL=http://127.0.0.1:8000
# Must match CSRF_HEADER_NAME in backend settings.
NEXT_PUBLIC_CSRF_HEADER_NAME=X-CSRF-Token

# Match the backend USER_INITIAL_CREDITS offer.
NEXT_PUBLIC_WELCOME_CREDITS=15
# Optional verified support contact and approved legal documents.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=
