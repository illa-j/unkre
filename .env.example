# Host ports used by docker compose. This file is read by Compose itself;
# application secrets stay in backend/.env.
#
# Production (docker-compose.yml)
HTTP_PORT=80
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_HTTP_PORT=18081
API_WORKERS=2

# Baked into the frontend image at build time (docker compose build frontend).
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CSRF_HEADER_NAME=X-CSRF-Token
SITE_INDEXABLE=true

# Local database/Redis access from the host.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=55432
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=56379

# Development (docker-compose-dev.yml), all bound to 127.0.0.1
# HTTP_PORT=8080
# BACKEND_PORT=8000
# FRONTEND_PORT=3000

# Match the backend USER_INITIAL_CREDITS offer.
NEXT_PUBLIC_WELCOME_CREDITS=15
# Optional verified support contact and approved legal documents.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=
# Optional public Telegram bot / MiniApp link, for example https://t.me/your_bot
# Falls back to https://t.me/unkre_bot when left empty.
NEXT_PUBLIC_TELEGRAM_BOT_URL=

# MinIO image and bucket. MinIO removed minio/minio from Docker Hub in
# September 2026, so the stack defaults to the Chainguard build.
# Override with a digest, pgsty/silo or your own image if needed.
MINIO_IMAGE=cgr.dev/chainguard/minio:latest
MINIO_ROOT_USER=unkre
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
MINIO_BUCKET=unkre-images
MINIO_RETENTION_HOURS=24
